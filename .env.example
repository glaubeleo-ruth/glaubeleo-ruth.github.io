# Notion internal integration token (https://www.notion.so/profile/integrations)
# The integration must be connected to the "Projects" database in Notion.
NOTION_TOKEN=
# Optional: override the Projects data source ID
# NOTION_PROJECTS_DATA_SOURCE_ID=4087838e-f4c8-44b1-bc01-6390738c9939

# Private /dashboard (server-rendered on Vercel)
# Separate integration with Read + Update + Insert content, connected to the "Jungwoo's Hub" page
NOTION_DASHBOARD_TOKEN=
DASHBOARD_PASSWORD=
# Random string used to sign the session cookie, e.g. `openssl rand -hex 32`
DASHBOARD_SECRET=
