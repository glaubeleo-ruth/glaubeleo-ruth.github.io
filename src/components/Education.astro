---
import { siteConfig } from "../config";
import Section from "./Section.astro";
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{
  hasEducation && (
    <Section id="education" title="Education" tinted>
      <div class="space-y-4 md:space-y-5">
        {siteConfig.education.map((edu) => (
          <article class="tile bg-tile-2 p-7 sm:p-9 md:p-12" data-reveal>
            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-3 md:gap-10">
              <div>
                <h3 class="text-2xl md:text-[2rem] leading-tight font-semibold tracking-[-0.02em] text-fg">{edu.degree}</h3>
                {edu.minor && <p class="mt-2 text-base text-fg-2">{edu.minor}</p>}
                <p class="mt-1.5 text-lg text-accent">{edu.school}</p>
              </div>
              <p class="font-mono text-sm text-fg-3 md:pt-2 shrink-0">{edu.dateRange}</p>
            </div>
            <ul class="mt-8 space-y-3 max-w-3xl">
              {edu.achievements.map((achievement) => (
                <li class="relative pl-5 text-base leading-relaxed text-fg-2 before:absolute before:left-0 before:top-[0.7em] before:h-1 before:w-1 before:rounded-full before:bg-fg-3">
                  {achievement}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </Section>
  )
}
