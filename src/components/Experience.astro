---
import { siteConfig } from "../config";
import Section from "./Section.astro";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <Section id="experience" title="Experience">
      <ol class="border-t border-line">
        {siteConfig.experience.map((exp) => (
          <li class="grid grid-cols-1 md:grid-cols-12 gap-x-10 gap-y-3 py-10 md:py-12 border-b border-line" data-reveal>
            <p class="md:col-span-3 font-mono text-sm text-fg-3 md:pt-1.5">{exp.dateRange}</p>
            <div class="md:col-span-9">
              <h3 class="text-2xl md:text-[1.75rem] leading-tight font-semibold tracking-[-0.02em] text-fg">{exp.title}</h3>
              <p class="mt-1.5 text-lg text-accent">{exp.company}</p>
              {exp.bullets.length > 0 && (
                <ul class="mt-6 space-y-3">
                  {exp.bullets.map((bullet) => (
                    <li class="relative pl-5 text-base leading-relaxed text-fg-2 before:absolute before:left-0 before:top-[0.7em] before:h-1 before:w-1 before:rounded-full before:bg-fg-3">
                      {bullet}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ol>
    </Section>
  )
}
