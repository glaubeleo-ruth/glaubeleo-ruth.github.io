---
import { daysBetween } from "../../lib/dashboard";

interface Props {
  today: string;
  date?: string;
}

const { today, date } = Astro.props;
const days = date ? daysBetween(today, date) : undefined;

const label =
  days === undefined ? "No date"
  : days < 0 ? `${-days}d overdue`
  : days === 0 ? "Today"
  : `D-${days}`;
const tone =
  days === undefined ? "bg-gray-100 text-gray-400"
  : days < 0 ? "bg-red-100 text-red-700"
  : days <= 2 ? "bg-orange-100 text-orange-700"
  : days <= 7 ? "bg-yellow-100 text-yellow-800"
  : "bg-gray-100 text-gray-600";
---

<span class={`shrink-0 px-2 py-0.5 rounded-md text-xs font-medium tabular-nums ${tone}`} title={date}>
  {label}
</span>
