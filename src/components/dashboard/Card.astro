---
interface Props {
  title: string;
  count?: number;
  href?: string; // "open in Notion" link
  id?: string;
}

const { title, count, href, id } = Astro.props;
---

<section id={id} class="bg-white rounded-2xl border border-gray-200 p-5 sm:p-6 space-y-4 min-w-0">
  <header class="flex items-center justify-between gap-3">
    <h2 class="font-bold text-gray-900">
      {title}
      {count !== undefined && <span class="ml-1.5 text-sm font-medium text-gray-400">{count}</span>}
    </h2>
    {href && (
      <a href={href} target="_blank" rel="noopener noreferrer" class="text-xs text-gray-400 hover:text-gray-900 transition-colors">
        Notion ↗
      </a>
    )}
  </header>
  <slot />
</section>
