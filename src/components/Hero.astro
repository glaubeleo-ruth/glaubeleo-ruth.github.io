---
import { siteConfig } from "../config";
import Icon from "./Icon.astro";

const socials = [
  siteConfig.social?.email && { href: `mailto:${siteConfig.social.email}`, label: "Email", icon: "email" as const, external: false },
  siteConfig.social?.linkedin && { href: siteConfig.social.linkedin, label: "LinkedIn", icon: "linkedin" as const, external: true },
  siteConfig.social?.github && { href: siteConfig.social.github, label: "GitHub", icon: "github" as const, external: true },
].filter(Boolean) as { href: string; label: string; icon: "email" | "linkedin" | "github"; external: boolean }[];
---

<section id="hero" class="relative isolate overflow-hidden">
  <div class="shell absolute inset-x-0 top-0 bottom-0 -z-10" aria-hidden="true">
    <div class="relative h-full"><div class="column-guides"></div></div>
  </div>
  <div
    class="pointer-events-none absolute -top-40 left-1/2 -z-20 h-[36rem] w-[60rem] -translate-x-1/2 rounded-full opacity-60 blur-3xl"
    style="background: radial-gradient(closest-side, var(--accent-soft), transparent)"
    aria-hidden="true"
  >
  </div>

  <div class="shell relative flex min-h-[72svh] md:min-h-[calc(100svh-3.25rem)] flex-col justify-center py-16 md:py-28">
    <p class="hero-in font-mono text-lg sm:text-xl md:text-2xl text-fg-2">Hello! 👋</p>
    <h1
      class="hero-in mt-5 md:mt-6 text-[clamp(3.25rem,11vw,8.5rem)] font-bold leading-[0.95] tracking-[-0.045em] text-fg text-balance"
      style="animation-delay: 80ms"
    >
      I'm <span class="text-accent">{siteConfig.name}</span>
    </h1>
    <p
      class="hero-in mt-6 md:mt-8 max-w-2xl text-xl sm:text-2xl md:text-[1.75rem] leading-snug font-medium tracking-tight text-fg-2"
      style="animation-delay: 160ms"
    >
      {siteConfig.title}
    </p>

    <ul class="hero-in mt-10 md:mt-12 flex flex-wrap gap-2 sm:gap-3" style="animation-delay: 240ms">
      {
        socials.map((s, i) => (
          <li>
            <a
              href={s.href}
              class={`pill ${i === 0 ? "pill-solid" : ""}`}
              {...(s.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              <Icon name={s.icon} class="w-[18px] h-[18px]" />
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-in {
      animation: hero-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
