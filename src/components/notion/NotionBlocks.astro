---
import type { NotionBlock } from "../../lib/notion";
import RichText from "./RichText.astro";

interface Props {
  blocks: NotionBlock[];
}

const { blocks } = Astro.props;

// Notion returns list items as siblings; group consecutive ones into a single <ul>/<ol>.
type Group =
  | { kind: "block"; block: NotionBlock }
  | { kind: "bulleted" | "numbered"; items: NotionBlock[] };

const groups: Group[] = [];
for (const block of blocks) {
  const kind =
    block.type === "bulleted_list_item" ? "bulleted"
    : block.type === "numbered_list_item" ? "numbered"
    : null;
  const last = groups.at(-1);
  if (kind && last?.kind === kind) last.items.push(block);
  else if (kind) groups.push({ kind, items: [block] });
  else groups.push({ kind: "block", block });
}

// Literal class names so Tailwind picks them up.
const calloutColors: Record<string, string> = {
  blue_background: "bg-blue-50 border-blue-100",
  green_background: "bg-green-50 border-green-100",
  purple_background: "bg-purple-50 border-purple-100",
  orange_background: "bg-orange-50 border-orange-100",
  red_background: "bg-red-50 border-red-100",
  yellow_background: "bg-yellow-50 border-yellow-100",
};
const calloutClass = (color: string) => calloutColors[color] ?? "bg-gray-50 border-gray-200";

const gridCols: Record<number, string> = {
  2: "md:grid-cols-2",
  3: "md:grid-cols-3",
  4: "md:grid-cols-4",
};
---

{
  groups.map((group) => {
    if (group.kind === "bulleted") {
      return (
        <ul class="list-disc pl-6 space-y-1.5 text-gray-700 leading-relaxed">
          {group.items.map((item) => item.type === "bulleted_list_item" && (
            <li>
              <RichText text={item.bulleted_list_item.rich_text} />
              {item.children.length > 0 && <Astro.self blocks={item.children} />}
            </li>
          ))}
        </ul>
      );
    }
    if (group.kind === "numbered") {
      return (
        <ol class="list-decimal pl-6 space-y-1.5 text-gray-700 leading-relaxed">
          {group.items.map((item) => item.type === "numbered_list_item" && (
            <li>
              <RichText text={item.numbered_list_item.rich_text} />
              {item.children.length > 0 && <Astro.self blocks={item.children} />}
            </li>
          ))}
        </ol>
      );
    }

    const block = group.block;
    switch (block.type) {
      case "heading_1":
      case "heading_2":
        return (
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 pt-8">
            <RichText text={block.type === "heading_1" ? block.heading_1.rich_text : block.heading_2.rich_text} />
          </h2>
        );
      case "heading_3":
        return (
          <h3 class="text-xl font-bold text-gray-900 pt-4">
            <RichText text={block.heading_3.rich_text} />
          </h3>
        );
      case "paragraph":
        return block.paragraph.rich_text.length > 0 ? (
          <p class="text-gray-700 leading-relaxed whitespace-pre-line">
            <RichText text={block.paragraph.rich_text} />
          </p>
        ) : null;
      case "quote":
        return (
          <blockquote class="border-l-4 border-gray-300 pl-4 italic text-gray-600">
            <RichText text={block.quote.rich_text} />
          </blockquote>
        );
      case "callout":
        return (
          <div class={`flex gap-3 p-4 sm:p-5 rounded-xl border ${calloutClass(block.callout.color)}`}>
            {block.callout.icon?.type === "emoji" && (
              <span class="text-xl leading-none">{block.callout.icon.emoji}</span>
            )}
            <div class="space-y-3 text-gray-700 leading-relaxed whitespace-pre-line min-w-0">
              <div><RichText text={block.callout.rich_text} /></div>
              {block.children.length > 0 && <Astro.self blocks={block.children} />}
            </div>
          </div>
        );
      case "column_list":
        return (
          <div class={`grid grid-cols-1 gap-4 ${gridCols[block.children.length] ?? "md:grid-cols-2"}`}>
            {block.children.map((column) => (
              <div class="space-y-4 min-w-0">
                <Astro.self blocks={column.children} />
              </div>
            ))}
          </div>
        );
      case "image": {
        // Notion-hosted file URLs expire after ~1 hour, which would break a static build.
        if (block.image.type !== "external") {
          console.warn(`[notion] Skipping Notion-hosted image ${block.id}; use an external URL.`);
          return null;
        }
        const caption = block.image.caption.map((t) => t.plain_text).join("");
        return (
          <figure class="space-y-2">
            <img
              src={block.image.external.url}
              alt={caption}
              loading="lazy"
              class="w-full rounded-xl border border-gray-200"
            />
            {caption && <figcaption class="text-sm text-gray-500 text-center">{caption}</figcaption>}
          </figure>
        );
      }
      case "table": {
        const [header, ...rows] = block.table.has_column_header
          ? block.children
          : [null, ...block.children];
        const cells = (row: NotionBlock) => (row.type === "table_row" ? row.table_row.cells : []);
        return (
          <div class="overflow-x-auto rounded-xl border border-gray-200">
            <table class="w-full text-sm sm:text-base">
              {header && (
                <thead class="bg-gray-50 text-left">
                  <tr>
                    {cells(header).map((cell) => (
                      <th class="px-4 py-2.5 font-semibold text-gray-900">
                        <RichText text={cell} />
                      </th>
                    ))}
                  </tr>
                </thead>
              )}
              <tbody class="divide-y divide-gray-100">
                {rows.map((row) => (
                  <tr>
                    {cells(row).map((cell) => (
                      <td class="px-4 py-2.5 text-gray-700">
                        <RichText text={cell} />
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        );
      }
      case "code": {
        const source = block.code.rich_text.map((t) => t.plain_text).join("");
        return block.code.language === "mermaid" ? (
          <pre class="mermaid flex justify-center p-4 rounded-xl border border-gray-200 bg-white">{source}</pre>
        ) : (
          <pre class="p-4 rounded-xl bg-gray-900 text-gray-100 text-sm overflow-x-auto"><code>{source}</code></pre>
        );
      }
      case "divider":
        return <hr class="border-gray-200" />;
      default:
        return null;
    }
  })
}
