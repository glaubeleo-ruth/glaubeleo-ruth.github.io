---
import { siteConfig } from "../config";
import Section from "./Section.astro";
---

<Section id="research-interests" title="Research Interests">
  <ul class="border-t border-line">
    {
      siteConfig.researchInterests.map((interest, i) => (
        <li class="flex items-baseline gap-6 md:gap-10 py-6 md:py-8 border-b border-line" data-reveal>
          <span class="font-mono text-sm text-fg-3 shrink-0" aria-hidden="true">
            0{i + 1}
          </span>
          <span class="text-[clamp(1.375rem,3vw,2.25rem)] leading-tight font-semibold tracking-[-0.02em] text-fg">
            {interest}
          </span>
        </li>
      ))
    }
  </ul>
</Section>
