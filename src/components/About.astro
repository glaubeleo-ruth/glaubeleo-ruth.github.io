---
import { siteConfig } from "../config";
import Section from "./Section.astro";
---

<Section id="about" title="About Me">
  <p
    class="max-w-4xl text-[clamp(1.375rem,2.6vw,2rem)] leading-[1.35] font-semibold tracking-[-0.015em] text-fg-2"
    data-reveal
  >
    {siteConfig.aboutMe}
  </p>

  <ul class="mt-12 md:mt-16 flex flex-wrap gap-2.5 max-w-4xl" aria-label="Skills" data-reveal>
    {siteConfig.skills.map((skill) => <li class="chip">{skill}</li>)}
  </ul>
</Section>
