---
import { getProjects } from "../lib/notion";
import Section from "./Section.astro";
import Icon from "./Icon.astro";

const projects = await getProjects();
const hasProjects = projects.length > 0;
---

{
  hasProjects && (
    <Section id="projects" title="Projects" tinted>
      {/* Bento: the first project spans the full row, the rest pair up two per row. */}
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-5">
        {projects.map((project, index) => {
          // Notion projects open /projects/<slug>; config projects with a detail page open
          // /work/<slug>; the rest link out to GitHub.
          const internal = project.notionId
            ? `/projects/${project.slug}`
            : project.detail && project.slug
              ? `/work/${project.slug}`
              : undefined;
          const href = internal ?? project.link;
          const Component = href ? "a" : "div";
          const linkProps = internal
            ? { href }
            : project.link
              ? { href: project.link, target: "_blank", rel: "noopener noreferrer" }
              : {};
          const featured = index === 0;
          const meta = [project.period, project.team, project.role].filter(Boolean).join(" · ");
          const stats = featured && project.highlight ? project.highlight.split(" · ") : [];

          return (
            <li class={featured ? "md:col-span-2" : ""} data-reveal>
              <Component
                {...linkProps}
                class={`group relative flex h-full flex-col tile bg-tile-2 p-7 sm:p-9 ${featured ? "md:p-12" : ""} ${
                  href ? "project-link" : ""
                }`}
              >
                <div class="flex items-start justify-between gap-6">
                  <span class="font-mono text-sm text-accent">0{index + 1}</span>
                  {href && (
                    <span class="arrow grid h-9 w-9 shrink-0 place-items-center rounded-full bg-tile text-fg transition-colors">
                      <Icon name={internal ? "arrow-right" : "arrow-up-right"} class="w-[18px] h-[18px]" />
                      <span class="sr-only">{internal ? "Read case study" : "Open on GitHub"}</span>
                    </span>
                  )}
                </div>

                <h3
                  class={`mt-6 font-semibold tracking-[-0.02em] text-fg text-balance ${
                    featured ? "text-3xl sm:text-4xl md:text-5xl leading-[1.05]" : "text-2xl sm:text-[1.75rem] leading-tight"
                  }`}
                >
                  {project.name}
                </h3>
                {meta && <p class="mt-3 font-mono text-xs sm:text-[0.8125rem] text-fg-3">{meta}</p>}

                <p class={`mt-5 text-fg-2 leading-relaxed ${featured ? "text-lg md:text-xl max-w-3xl" : "text-base"}`}>
                  {project.description}
                </p>

                {stats.length > 0 ? (
                  <ul class="mt-8 md:mt-10 grid grid-cols-1 sm:grid-cols-3 border-t border-line">
                    {stats.map((s) => (
                      <li class="pt-5 pb-1 max-sm:not-first:border-t max-sm:not-first:mt-5 border-line sm:pr-6 sm:not-first:pl-6 sm:not-first:border-l text-xl md:text-2xl font-semibold leading-snug tracking-tight text-accent">
                        {s}
                      </li>
                    ))}
                  </ul>
                ) : (
                  project.highlight && (
                    <p class="mt-5 font-mono text-sm font-medium leading-relaxed text-accent">{project.highlight}</p>
                  )
                )}

                {project.skills && project.skills.length > 0 && (
                  <ul class="mt-auto flex flex-wrap gap-1.5 pt-7" aria-label="Skills">
                    {project.skills.map((skill) => (
                      <li class="chip chip-mono">{skill}</li>
                    ))}
                  </ul>
                )}
              </Component>
            </li>
          );
        })}
      </ul>
    </Section>
  )
}

<style>
  .project-link {
    transition:
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .project-link:hover {
    box-shadow: 0 18px 50px -20px rgb(0 0 0 / 0.25);
  }
  @media (prefers-reduced-motion: no-preference) {
    .project-link:hover {
      transform: translateY(-4px);
    }
  }
  .project-link:hover .arrow {
    background: var(--fg);
    color: var(--bg);
  }
</style>
