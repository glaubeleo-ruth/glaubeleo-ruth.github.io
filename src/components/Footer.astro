---
import { siteConfig } from "../config";
import Icon from "./Icon.astro";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;

const links = [
  { href: "/#about", label: "About" },
  hasProjects && { href: "/#projects", label: "Projects" },
  hasExperience && { href: "/#experience", label: "Experience" },
  hasEducation && { href: "/#education", label: "Education" },
].filter(Boolean) as { href: string; label: string }[];

// Only render the profiles that exist in the config.
const socials = [
  siteConfig.social?.email && { href: `mailto:${siteConfig.social.email}`, label: "Email", icon: "email" as const, external: false },
  siteConfig.social?.linkedin && { href: siteConfig.social.linkedin, label: "LinkedIn", icon: "linkedin" as const, external: true },
  siteConfig.social?.github && { href: siteConfig.social.github, label: "GitHub", icon: "github" as const, external: true },
].filter(Boolean) as { href: string; label: string; icon: "email" | "linkedin" | "github"; external: boolean }[];
---

<footer class="border-t border-line bg-bg-2">
  <div class="shell py-14 md:py-16">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-10">
      <div>
        <p class="text-2xl font-semibold tracking-tight text-fg">{siteConfig.name}</p>
        <p class="mt-2 text-base text-fg-2">{siteConfig.title}</p>
        <ul class="mt-6 flex gap-2">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  aria-label={s.label}
                  class="grid h-11 w-11 place-items-center rounded-full border border-line text-fg-2 transition-colors hover:text-fg hover:border-fg"
                  {...(s.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                >
                  <Icon name={s.icon} class="w-5 h-5" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="flex flex-col md:items-end gap-4">
        <nav aria-label="Footer">
          <ul class="flex flex-wrap gap-x-7 gap-y-2">
            {
              links.map((l) => (
                <li>
                  <a href={l.href} class="text-sm text-fg-2 hover:text-fg transition-colors">
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <p class="text-xs text-fg-3">
          © {new Date().getFullYear()}
          {siteConfig.name}. All rights reserved.
        </p>
      </div>
    </div>
  </div>
</footer>
