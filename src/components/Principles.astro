---
import { siteConfig } from "../config";
import Section from "./Section.astro";
---

<Section id="principles" title="How I Work" tinted>
  <ol class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5">
    {
      siteConfig.principles.map((p, i) => (
        <li class="tile bg-tile-2 p-7 md:p-8 flex flex-col" data-reveal>
          <span class="font-mono text-sm text-accent" aria-hidden="true">
            0{i + 1}
          </span>
          <h3 class="mt-10 md:mt-14 text-2xl md:text-[1.625rem] leading-tight font-semibold tracking-tight text-fg">
            {p.title}
          </h3>
          <p class="mt-3 text-base leading-relaxed text-fg-2">{p.body}</p>
        </li>
      ))
    }
  </ol>
</Section>
