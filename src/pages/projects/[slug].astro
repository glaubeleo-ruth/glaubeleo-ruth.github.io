---
import Site from "../../layouts/Site.astro";
import Icon from "../../components/Icon.astro";
import NotionBlocks from "../../components/notion/NotionBlocks.astro";
import { siteConfig } from "../../config";
import { getBlocks, getProjects, type NotionProject } from "../../lib/notion";

// Only Notion-sourced projects have a slug; the siteConfig fallback yields no pages.
export async function getStaticPaths() {
  const projects = await getProjects();
  return projects
    .filter((project) => project.slug && project.notionId)
    .map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: NotionProject;
}

const { project } = Astro.props;
const allBlocks = await getBlocks(project.notionId!);
// Project pages open with an intro callout that repeats the header above; drop it here.
const blocks = allBlocks[0]?.type === "callout" ? allBlocks.slice(1) : allBlocks;
const hasMermaid = blocks.some(function containsMermaid(b): boolean {
  return (b.type === "code" && b.code.language === "mermaid") || b.children.some(containsMermaid);
});
---

<Site title={`${project.name} - ${siteConfig.name}`} description={project.description}>
  <article>
    <header class="relative isolate overflow-hidden">
      <div class="shell absolute inset-x-0 top-0 bottom-0 -z-10" aria-hidden="true">
        <div class="relative h-full"><div class="column-guides"></div></div>
      </div>
      <div class="shell pt-10 md:pt-14 pb-14 md:pb-20">
        <a href="/#projects" class="inline-flex items-center gap-2 font-mono text-sm text-fg-2 hover:text-fg transition-colors">
          <Icon name="arrow-left" class="w-4 h-4" />
          All projects
        </a>
        {(project.context || project.period) && (
          <p class="eyebrow mt-14 md:mt-20">{[project.context, project.period].filter(Boolean).join(" · ")}</p>
        )}
        <h1 class="mt-4 max-w-5xl text-[clamp(2.5rem,7vw,5.5rem)] font-bold leading-[1.02] tracking-[-0.04em] text-fg text-balance">
          {project.name}
        </h1>
        <p class="mt-8 max-w-3xl text-xl md:text-2xl leading-[1.45] font-medium tracking-[-0.01em] text-fg-2">{project.description}</p>
        <div class="mt-8 flex flex-col sm:flex-row sm:items-center gap-5">
          <ul class="flex flex-wrap gap-1.5" aria-label="Skills">
            {project.skills.map((skill) => <li class="chip chip-mono">{skill}</li>)}
          </ul>
          {project.link && (
            <a href={project.link} target="_blank" rel="noopener noreferrer" class="pill pill-solid sm:ml-auto self-start shrink-0">
              <Icon name="github" class="w-[18px] h-[18px]" />
              View on GitHub
              <Icon name="arrow-up-right" class="w-4 h-4" />
            </a>
          )}
        </div>
      </div>
    </header>

    <div class="border-t border-line">
      <div class="shell max-w-4xl! py-16 md:py-24 space-y-6 notion-prose text-lg">
        <NotionBlocks blocks={blocks} />
      </div>
    </div>
  </article>

  {hasMermaid && (
    <script type="module" is:inline>
      import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs";
      mermaid.initialize({ startOnLoad: true, theme: "neutral" });
    </script>
  )}
</Site>
