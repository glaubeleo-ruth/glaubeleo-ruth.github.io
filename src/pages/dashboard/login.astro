---
import Base from "../../layouts/Base.astro";
import { siteConfig } from "../../config";
import { authConfigured, checkPassword, isAuthenticated, startSession } from "../../lib/auth";

export const prerender = false;

if (isAuthenticated(Astro.cookies)) return Astro.redirect("/dashboard");

let error = "";
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (checkPassword(String(form.get("password") ?? ""))) {
    startSession(Astro.cookies);
    return Astro.redirect("/dashboard", 303);
  }
  error = "Wrong password.";
}
---

<Base title="Dashboard login" noindex>
  <main class="min-h-screen flex items-center justify-center px-6 bg-gray-50">
    <form method="POST" class="w-full max-w-sm space-y-4 p-8 bg-white rounded-2xl border border-gray-200">
      <h1 class="text-2xl font-bold text-gray-900">Dashboard</h1>
      <div class="w-[50px] h-[4px] rounded-full" style={`background-color: ${siteConfig.accentColor}`} />
      {authConfigured() ? (
        <>
          <input
            type="password"
            name="password"
            placeholder="Password"
            autofocus
            required
            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:outline-none focus:border-gray-900"
          />
          {error && <p class="text-sm text-red-600">{error}</p>}
          <button type="submit" class="w-full py-2.5 rounded-lg bg-gray-900 text-white font-medium hover:bg-gray-700 transition-colors">
            Sign in
          </button>
        </>
      ) : (
        <p class="text-sm text-gray-600">
          Set <code>DASHBOARD_PASSWORD</code> and <code>DASHBOARD_SECRET</code> to enable the dashboard.
        </p>
      )}
    </form>
  </main>
</Base>
