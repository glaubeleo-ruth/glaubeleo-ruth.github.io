---
import Base from "../../layouts/Base.astro";
import { siteConfig, type Project } from "../../config";

// One static page per config project that has a `detail` block.
export function getStaticPaths() {
  const withDetail = siteConfig.projects.filter((p) => p.detail && p.slug);
  return withDetail.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: withDetail[(i + 1) % withDetail.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const d = project.detail!;
const accent = siteConfig.accentColor;
const meta = [
  ["Period", project.period],
  ["Team", project.team],
  ["Role", project.role],
].filter(([, v]) => v) as [string, string][];
---

<Base title={`${project.name} - ${siteConfig.name}`} description={project.description}>
  <main class="max-w-4xl mx-auto px-6 sm:px-8 py-12 sm:py-16 space-y-12">
    <a href="/#projects" class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-900 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      All projects
    </a>

    <header class="space-y-5">
      {project.context && <p class="text-sm font-mono" style={{ color: accent }}>{project.context}</p>}
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900">{project.name}</h1>
      <div class="w-[75px] h-[5px] rounded-full" style={`background-color: ${accent}`} />
      <dl class="flex flex-wrap gap-x-10 gap-y-3 pt-1">
        {meta.map(([k, v]) => (
          <div>
            <dt class="text-xs uppercase tracking-wider text-gray-500">{k}</dt>
            <dd class="text-base font-semibold text-gray-900">{v}</dd>
          </div>
        ))}
      </dl>
      <div class="flex flex-wrap items-center gap-2 pt-1">
        {project.skills.map((skill) => (
          <span class="px-3 py-1.5 bg-gray-900 text-white rounded-lg text-sm font-medium">{skill}</span>
        ))}
        {project.link && (
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="ml-auto inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-gray-300 text-sm font-medium text-gray-900 hover:bg-gray-50 transition-colors"
          >
            View on GitHub
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
            </svg>
          </a>
        )}
      </div>
    </header>

    <section class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {d.metrics.map((m) => (
        <div class={`rounded-2xl p-5 ${m.highlight ? "bg-blue-50" : "bg-gray-50"}`}>
          <div class="text-2xl sm:text-3xl font-bold" style={m.highlight ? { color: accent } : {}}>{m.value}</div>
          <div class="text-sm text-gray-600 mt-1 leading-snug">{m.label}</div>
        </div>
      ))}
    </section>

    <section class="grid grid-cols-1 md:grid-cols-5 gap-8">
      <div class="md:col-span-3 space-y-6">
        <div>
          <h2 class="text-xl font-bold text-gray-900 mb-2">The problem</h2>
          <p class="text-gray-600 leading-relaxed">{d.problem}</p>
        </div>
        {d.approach && (
          <div>
            <h2 class="text-xl font-bold text-gray-900 mb-2">Approach</h2>
            <p class="text-gray-600 leading-relaxed">{d.approach}</p>
          </div>
        )}
      </div>
      <div class="md:col-span-2 rounded-r-2xl bg-gray-50 p-5 border-l-4" style={`border-color: ${accent}`}>
        <h2 class="text-xl font-bold text-gray-900 mb-3">What I did</h2>
        <ul class="space-y-2">
          {d.contributions.map((c) => (
            <li class="flex gap-2 text-gray-700 leading-snug">
              <span class="mt-2 w-1.5 h-1.5 rounded-full shrink-0" style={`background-color: ${accent}`} />
              <span>{c}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {d.sections.map((s) => (
      <section class="space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold text-gray-900">{s.title}</h2>
        {s.body && <p class="text-gray-600 leading-relaxed">{s.body}</p>}
        {s.cards && (
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {s.cards.map((c) => (
              <div class="rounded-2xl border border-gray-200 p-5">
                <h3 class="font-bold text-gray-900">{c.title}</h3>
                <p class="text-sm text-gray-600 mt-2 leading-relaxed">{c.body}</p>
                {c.note && <p class="text-xs font-semibold mt-3" style={{ color: accent }}>✕ {c.note}</p>}
              </div>
            ))}
          </div>
        )}
        {s.bullets && (
          <ul class="space-y-3">
            {s.bullets.map((b) => (
              <li class="flex gap-2 text-gray-600 leading-relaxed">
                <span class="mt-2.5 w-1.5 h-1.5 rounded-full shrink-0" style={`background-color: ${accent}`} />
                <span>{b}</span>
              </li>
            ))}
          </ul>
        )}
        {s.table && (
          <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
              <thead>
                <tr class="border-b-2 border-gray-900">
                  {s.table.headers.map((h) => <th class="py-2 pr-4 text-xs uppercase tracking-wider text-gray-500">{h}</th>)}
                </tr>
              </thead>
              <tbody>
                {s.table.rows.map((r) => (
                  <tr class="border-b border-gray-200">
                    {r.map((c, i) => <td class={`py-3 pr-4 align-top ${i === 0 ? "font-semibold text-gray-900" : "text-gray-600"}`}>{c}</td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {s.figure && (
          <figure>
            <img src={s.figure.src} alt={s.figure.alt} loading="lazy" class="w-full rounded-2xl border border-gray-200" />
            {s.figure.caption && <figcaption class="text-sm text-gray-500 mt-2 leading-relaxed">{s.figure.caption}</figcaption>}
          </figure>
        )}
      </section>
    ))}

    {d.lesson && (
      <section class="rounded-r-2xl bg-orange-50 p-5 sm:p-6 border-l-4 border-orange-500">
        <h2 class="text-lg font-bold text-gray-900 mb-2">What I learned</h2>
        <p class="text-gray-700 leading-relaxed">{d.lesson}</p>
      </section>
    )}

    <nav class="flex justify-between items-center pt-8 border-t border-gray-200 text-sm">
      <a href="/#projects" class="text-gray-500 hover:text-gray-900">← All projects</a>
      {next.slug !== project.slug && (
        <a href={`/work/${next.slug}`} class="font-semibold hover:underline" style={{ color: accent }}>Next: {next.name} →</a>
      )}
    </nav>
  </main>
</Base>
