---
import Site from "../../layouts/Site.astro";
import Icon from "../../components/Icon.astro";
import { siteConfig, type Project } from "../../config";

// One static page per config project that has a `detail` block.
export function getStaticPaths() {
  const withDetail = siteConfig.projects.filter((p) => p.detail && p.slug);
  return withDetail.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: withDetail[(i + 1) % withDetail.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const d = project.detail!;
const meta = [
  ["Period", project.period],
  ["Team", project.team],
  ["Role", project.role],
].filter(([, v]) => v) as [string, string][];
const bullet =
  "relative pl-5 before:absolute before:left-0 before:top-[0.7em] before:h-1.5 before:w-1.5 before:rounded-full before:bg-accent";
---

<Site title={`${project.name} - ${siteConfig.name}`} description={project.description}>
  <article>
    <!-- Hero -->
    <header class="relative isolate overflow-hidden">
      <div class="shell absolute inset-x-0 top-0 bottom-0 -z-10" aria-hidden="true">
        <div class="relative h-full"><div class="column-guides"></div></div>
      </div>
      <div class="shell pt-10 md:pt-14 pb-16 md:pb-24">
        <a href="/#projects" class="inline-flex items-center gap-2 font-mono text-sm text-fg-2 hover:text-fg transition-colors">
          <Icon name="arrow-left" class="w-4 h-4" />
          All projects
        </a>

        {project.context && <p class="eyebrow mt-14 md:mt-20">{project.context}</p>}
        <h1
          class="mt-4 max-w-5xl text-[clamp(2.5rem,7vw,5.5rem)] font-bold leading-[1.02] tracking-[-0.04em] text-fg text-balance"
        >
          {project.name}
        </h1>

        {
          meta.length > 0 && (
            <dl class="mt-10 md:mt-14 grid grid-cols-2 sm:grid-cols-3 border-t border-line">
              {meta.map(([k, v]) => (
                <div class="py-4 sm:py-5 pr-4 sm:pr-6 max-sm:border-b max-sm:border-line max-sm:odd:last:col-span-2 sm:not-first:pl-6 sm:not-first:border-l sm:border-line">
                  <dt class="font-mono text-xs uppercase tracking-wider text-fg-3">{k}</dt>
                  <dd class="mt-1.5 text-lg font-semibold tracking-tight text-fg">{v}</dd>
                </div>
              ))}
            </dl>
          )
        }

        <div class="mt-8 flex flex-col sm:flex-row sm:items-center gap-5">
          <ul class="flex flex-wrap gap-1.5" aria-label="Skills">
            {project.skills.map((skill) => <li class="chip chip-mono">{skill}</li>)}
          </ul>
          {
            project.link && (
              <a href={project.link} target="_blank" rel="noopener noreferrer" class="pill pill-solid sm:ml-auto self-start shrink-0">
                <Icon name="github" class="w-[18px] h-[18px]" />
                View on GitHub
                <Icon name="arrow-up-right" class="w-4 h-4" />
              </a>
            )
          }
        </div>
      </div>
    </header>

    <!-- Metrics bento -->
    <section class="bg-bg-2 py-16 md:py-24" aria-label="Key results">
      <div class="shell">
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-5">
          {
            d.metrics.map((m) => (
              <li class="tile bg-tile-2 p-7 md:p-9 flex flex-col justify-between min-h-44" data-reveal>
                <p
                  class={`text-[clamp(2rem,4.5vw,3.25rem)] font-bold leading-none tracking-[-0.035em] ${
                    m.highlight ? "text-accent" : "text-fg"
                  }`}
                >
                  {m.value}
                </p>
                <p class="mt-6 text-base leading-snug text-fg-2">{m.label}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Problem / approach / contributions -->
    <section class="py-20 md:py-32">
      <div class="shell grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
        <div class="lg:col-span-7 space-y-14">
          <div data-reveal>
            <h2 class="eyebrow">The problem</h2>
            <p class="mt-4 text-xl md:text-2xl leading-[1.45] font-medium tracking-[-0.01em] text-fg">{d.problem}</p>
          </div>
          {
            d.approach && (
              <div data-reveal>
                <h2 class="eyebrow">Approach</h2>
                <p class="mt-4 text-lg md:text-xl leading-[1.55] text-fg-2">{d.approach}</p>
              </div>
            )
          }
        </div>
        <aside class="lg:col-span-5" data-reveal>
          <div class="tile p-7 md:p-9 lg:sticky lg:top-20">
            <h2 class="text-2xl font-semibold tracking-tight text-fg">What I did</h2>
            <ul class="mt-6 space-y-4">
              {d.contributions.map((c) => <li class={`${bullet} text-base leading-relaxed text-fg-2`}>{c}</li>)}
            </ul>
          </div>
        </aside>
      </div>
    </section>

    <!-- Detail sections -->
    {
      d.sections.map((s, si) => (
        <section class={`py-20 md:py-28 ${si % 2 === 0 ? "bg-bg-2" : ""}`}>
          <div class="shell">
            <h2
              class="max-w-4xl text-[clamp(2rem,4.5vw,3.25rem)] font-bold leading-[1.08] tracking-[-0.03em] text-fg text-balance"
              data-reveal
            >
              {s.title}
            </h2>
            {s.body && (
              <p class="mt-6 max-w-3xl text-lg md:text-xl leading-[1.55] text-fg-2" data-reveal>
                {s.body}
              </p>
            )}
            {s.cards && (
              <ul class="mt-10 md:mt-14 grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5">
                {s.cards.map((c) => (
                  <li class={`tile ${si % 2 === 0 ? "bg-tile-2" : ""} p-7 md:p-8 flex flex-col`} data-reveal>
                    <h3 class="text-xl font-semibold tracking-tight text-fg">{c.title}</h3>
                    <p class="mt-3 text-base leading-relaxed text-fg-2">{c.body}</p>
                    {c.note && <p class="mt-auto pt-6 font-mono text-xs font-medium text-accent">✕ {c.note}</p>}
                  </li>
                ))}
              </ul>
            )}
            {s.bullets && (
              <ul class="mt-8 max-w-3xl space-y-4">
                {s.bullets.map((b) => (
                  <li class={`${bullet} text-lg leading-relaxed text-fg-2`} data-reveal>
                    {b}
                  </li>
                ))}
              </ul>
            )}
            {s.table && (
              <div class="mt-10 overflow-x-auto" data-reveal>
                <table class="w-full text-left text-[0.9375rem]">
                  <thead>
                    <tr class="border-b border-fg">
                      {s.table.headers.map((h) => (
                        <th scope="col" class="py-3 pr-6 font-mono text-xs font-medium uppercase tracking-wider text-fg-3">
                          {h}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {s.table.rows.map((r) => (
                      <tr class="border-b border-line">
                        {r.map((c, i) => (
                          <td class={`py-4 pr-6 align-top ${i === 0 ? "font-semibold text-fg" : "text-fg-2"}`}>{c}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {s.figure && (
              <figure class="mt-10 md:mt-14" data-reveal>
                {/* Charts are drawn on white, so they sit on a white plate in both themes. */}
                <a
                  href={s.figure.src}
                  target="_blank"
                  rel="noopener"
                  class="block overflow-hidden rounded-[var(--radius-tile)] bg-white p-2 sm:p-4 ring-1 ring-line"
                  title="Open full-size image"
                >
                  <img src={s.figure.src} alt={s.figure.alt} loading="lazy" decoding="async" class="w-full h-auto" />
                </a>
                {s.figure.caption && (
                  <figcaption class="mt-4 max-w-3xl text-sm leading-relaxed text-fg-3">{s.figure.caption}</figcaption>
                )}
              </figure>
            )}
          </div>
        </section>
      ))
    }

    <!-- Lesson -->
    {
      d.lesson && (
        <section class="py-20 md:py-28">
          <div class="shell">
            <div class="tile p-8 sm:p-10 md:p-14" data-reveal>
              <h2 class="eyebrow">What I learned</h2>
              <p class="mt-5 max-w-4xl text-[clamp(1.375rem,2.6vw,2rem)] leading-[1.35] font-semibold tracking-[-0.015em] text-fg">
                {d.lesson}
              </p>
            </div>
          </div>
        </section>
      )
    }

    <!-- Next -->
    <nav class="border-t border-line" aria-label="Project navigation">
      <div class="shell py-12 md:py-16 flex flex-col sm:flex-row sm:items-end justify-between gap-8">
        <a href="/#projects" class="inline-flex items-center gap-2 font-mono text-sm text-fg-2 hover:text-fg transition-colors">
          <Icon name="arrow-left" class="w-4 h-4" />
          All projects
        </a>
        {
          next.slug !== project.slug && (
            <a href={`/work/${next.slug}`} class="group sm:text-right max-w-xl">
              <span class="font-mono text-sm text-fg-3">Next</span>
              <span class="mt-2 flex sm:justify-end items-center gap-3 text-2xl md:text-3xl font-semibold tracking-tight text-fg group-hover:text-accent transition-colors">
                {next.name}
                <Icon name="arrow-right" class="w-6 h-6 shrink-0 transition-transform group-hover:translate-x-1" />
              </span>
            </a>
          )
        }
      </div>
    </nav>
  </article>
</Site>
